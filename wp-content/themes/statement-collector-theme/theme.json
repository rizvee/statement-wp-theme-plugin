{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "gallery-ivory", "name": "Gallery Ivory", "color": "#F3F0EA" },
        { "slug": "warm-white", "name": "Warm White", "color": "#FAF9F6" },
        { "slug": "ink-navy", "name": "Ink Navy", "color": "#172131" },
        { "slug": "near-black", "name": "Near Black", "color": "#090B0F" },
        { "slug": "soft-graphite", "name": "Soft Graphite", "color": "#292B2F" },
        { "slug": "border-grey", "name": "Border Grey", "color": "#D8D4CC" },
        { "slug": "brass", "name": "Brass", "color": "#9A7A45" }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "2XS", "size": "clamp(0.375rem, 0.3rem + 0.25vw, 0.5rem)" },
        { "slug": "20", "name": "XS", "size": "clamp(0.625rem, 0.5rem + 0.4vw, 0.875rem)" },
        { "slug": "30", "name": "S", "size": "clamp(1rem, 0.8rem + 0.6vw, 1.375rem)" },
        { "slug": "40", "name": "M", "size": "clamp(1.5rem, 1.15rem + 1vw, 2.25rem)" },
        { "slug": "50", "name": "L", "size": "clamp(2.25rem, 1.7rem + 1.7vw, 3.5rem)" },
        { "slug": "60", "name": "XL", "size": "clamp(3.25rem, 2.3rem + 2.8vw, 5.5rem)" },
        { "slug": "70", "name": "2XL", "size": "clamp(4.5rem, 3.2rem + 4vw, 8rem)" }
      ],
      "units": ["px", "rem", "vh", "vw", "%"]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display / Editorial Accent",
          "fontFamily": "\"Instrument Serif\", \"Iowan Old Style\", \"Times New Roman\", serif"
        },
        {
          "slug": "ui",
          "name": "Contemporary Sans / Primary UI",
          "fontFamily": "Inter, \"Helvetica Neue\", Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "clamp(0.75rem, 0.72rem + 0.1vw, 0.8125rem)" },
        { "slug": "body", "name": "Body", "size": "clamp(0.9375rem, 0.9rem + 0.15vw, 1.0625rem)" },
        { "slug": "lead", "name": "Lead", "size": "clamp(1.0625rem, 1rem + 0.35vw, 1.25rem)" },
        { "slug": "heading-small", "name": "Heading Small", "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem)" },
        { "slug": "heading", "name": "Heading", "size": "clamp(1.75rem, 1.35rem + 1.5vw, 2.75rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(2.5rem, 1.75rem + 3vw, 4.5rem)" }
      ]
    }
  }
}
